{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],
	"schedule": [
		"0 * * * *"
	],

	"automergeSchedule": [
		"30 * * * *"
	],

	"major": {
		"enabled": true
	},

	"packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": true,
            "addLabels": ["auto-merge"]
        }
	]
}
